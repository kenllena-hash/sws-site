# Copy this file to .env on the hosting server and fill in your real values.
# Never commit the real .env file to GitHub.
SWS_DB_HOST=localhost
SWS_DB_USER=YOUR_CPANEL_DATABASE_USER
SWS_DB_PASS="YOUR_DATABASE_PASSWORD"
SWS_DB_NAME=YOUR_CPANEL_DATABASE_NAME

SWS_SMS_API_URL=https://api.semaphore.co/api/v4/messages
SWS_SMS_API_KEY=
SWS_SMS_SENDER_NAME=SWS
